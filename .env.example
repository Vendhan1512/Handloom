# ==============================================================================
# HANDLOOM OPERATIONS MANAGEMENT PLATFORM - ENVIRONMENT TEMPLATE
# ==============================================================================
# Security Notice: Copy this file to .env for local development.
# NEVER commit real credentials, secrets, or API keys to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=handloom_dev
POSTGRES_PASSWORD=handloom_dev_password_change_me
POSTGRES_DB=handloom_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# 2. CACHE & QUEUE BROKER (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ------------------------------------------------------------------------------
# 3. BACKEND API (NestJS)
# ------------------------------------------------------------------------------
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 4. FRONTEND (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Handloom Operations Platform"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY (Placeholders for Future Task)
# ------------------------------------------------------------------------------
# Minimum 32-character random string in production
JWT_SECRET=change_me_to_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change_me_to_a_secure_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 6. AI PROVIDER (Placeholders for Future Task)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 7. OBJECT STORAGE (S3 / MinIO - Placeholders for Future Task)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=handloom-documents
STORAGE_REGION=us-east-1
