# ==============================================================================
# HANDLOOM OPERATIONS MANAGEMENT PLATFORM - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# SECURITY NOTICE:
# Copy this template to .env for local development:
#   cp .env.example .env
# NEVER commit real credentials, production secrets, or private API keys to version control.
# In staging and production, secrets must be injected via external secret management
# systems (e.g., AWS Secrets Manager, HashiCorp Vault, Kubernetes Secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Allowed values: development | test | staging | production
NODE_ENV=development

# Human-readable application title
APP_NAME="Handloom Operations Platform"

# Backend API HTTP listening port (1-65535)
PORT=4000

# API routing prefix and version
API_PREFIX=/api/v1

# Allowed CORS Origins (comma-separated origins, or * in development ONLY)
# CAUTION: Wildcard (*) is strictly forbidden in staging and production
CORS_ORIGIN=http://localhost:3000

# Logging Level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# HTTP Request Timeout in milliseconds
REQUEST_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 2. RATE LIMITING & PAYLOAD GUARDS
# ------------------------------------------------------------------------------
# Time window in seconds
RATE_LIMIT_TTL=60

# Max requests per window per IP
RATE_LIMIT_LIMIT=100

# Max file upload size in bytes (10485760 = 10 MB)
MAX_FILE_SIZE_BYTES=10485760

# Allowed MIME types for multipart uploads (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=handloom_dev
POSTGRES_PASSWORD=handloom_dev_password_change_me
POSTGRES_DB=handloom_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Mandatory in staging & production environments:
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# 4. CACHE & QUEUE BROKER (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ------------------------------------------------------------------------------
# 5. FRONTEND PUBLIC ENVIRONMENT (Next.js)
# ------------------------------------------------------------------------------
# Only NEXT_PUBLIC_* variables are exposed to browser JavaScript bundles.
# NEVER prefix backend secrets or database credentials with NEXT_PUBLIC_.
NEXT_PUBLIC_APP_NAME="Handloom Operations Platform"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & TOKENS (Placeholders for Future Task)
# ------------------------------------------------------------------------------
# In staging/production, JWT_SECRET and REFRESH_TOKEN_SECRET must be at least
# 32 cryptographically random characters generated using `openssl rand -hex 32`.
JWT_SECRET=change_me_to_a_secure_random_secret_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_to_a_secure_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 7. OBJECT STORAGE (S3 / MinIO - Placeholders for Future Task)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=handloom-documents
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 8. AI PROVIDER (Google Gemini - Placeholders for Future Task)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash
