// ==============================================================================
// HANDLOOM OPERATIONS PLATFORM - MULTI-TENANT DATABASE SCHEMA
// ==============================================================================
// This schema establishes decoupled tenant memberships (cooperatives/clusters/mills),
// global user identities, role-based access control, cryptographically rotated sessions,
// and comprehensive audit logging.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum TenantType {
  COOPERATIVE
  PRIVATE_MILL
  MASTER_WEAVER_CLUSTER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  OFFICE_STAFF
  STOREKEEPER
  SUPERVISOR
  WEAVER
  QUALITY_INSPECTOR
  ACCOUNTANT
  TRANSPORT_STAFF
  // Backward-compatibility aliases
  SOCIETY_ADMIN
  MASTER_WEAVER
  INSPECTOR
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ------------------------------------------------------------------------------
// MULTI-TENANT MODELS
// ------------------------------------------------------------------------------

/// Handloom cooperative society, mill, or master weaver cluster
model Tenant {
  id           String       @id @default(uuid())
  name         String
  code         String       @unique /// Unique business code e.g. "KANCHI-01"
  slug         String?      @unique /// URL-friendly unique slug e.g. "kanchi-silk-weavers"
  type         TenantType   @default(COOPERATIVE)
  status       TenantStatus @default(ACTIVE)
  contactEmail String?      @map("contact_email")
  contactPhone String?      @map("contact_phone")
  address      String?
  settings     Json?        /// Tenant-specific configuration (e.g. piece rates, tax rules)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  memberships TenantMembership[]
  auditLogs   AuditLog[]

  @@index([status])
  @@index([code])
  @@index([slug])
  @@map("tenants")
}

/// Global user identity for authentication across societies/clusters
model User {
  id           String     @id @default(uuid())
  email        String     @unique /// Globally unique user login email
  phone        String?
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships TenantMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]

  @@index([email])
  @@index([status])
  @@map("users")
}

/// Tenant membership linking global user identity to a tenant with specific RBAC role
model TenantMembership {
  id        String           @id @default(uuid())
  tenantId  String           @map("tenant_id")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      UserRole         @default(WEAVER)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@map("tenant_memberships")
}

/// Cryptographically rotated refresh token sessions with family reuse detection
model Session {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenantId  String?   @map("active_tenant_id")
  tokenHash       String    @unique @map("token_hash")
  familyId        String    @default(uuid()) @map("family_id")
  parentTokenHash String?   @map("parent_token_hash")
  isRevoked       Boolean   @default(false) @map("is_revoked")
  userAgent       String?   @map("user_agent")
  ipAddress       String?   @map("ip_address")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("sessions")
}

/// Comprehensive, non-repudiation audit trail
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   /// e.g. "AUTH_LOGIN", "AUTH_REGISTER_SOCIETY", "AUTH_REFRESH_TOKEN_REUSE"
  entity    String   /// e.g. "User", "Tenant", "Session", "TenantMembership"
  entityId  String?  @map("entity_id")
  details   Json?    /// Contextual metadata regarding the action
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Baseline system health and version synchronization model
model SystemHealth {
  id        String   @id @default(uuid())
  version   String
  status    String   @default("HEALTHY")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_health")
}
